# SMS to WhatsApp Forwarder Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000

# WhatsApp Target Number (with country code, no + symbol)
WHATSAPP_TARGET=1234567890

# API Key for webhook authentication (change this to a secure random key)
API_KEY=change_me_to_secure_key

# Twilio Configuration (for twilio-whatsapp-bridge.js)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
