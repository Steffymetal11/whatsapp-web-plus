<?xml version="1.0" encoding="UTF-8"?>
<TaskerData sr="" dvi="1" tv="6.2.5">
  <!-- Tasker Profile: Forward SMS to WhatsApp -->
  <Profile sr="prof1" ve="2">
    <cdate>1234567890</cdate>
    <edate>1234567890</edate>
    <id>1</id>
    <mid0>2</mid0>
    <Event sr="con0" ve="2">
      <code>7</code>
      <Str sr="arg0" ve="3">*</Str>
      <Str sr="arg1" ve="3"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
    </Event>
  </Profile>
  
  <!-- Task: Forward to WhatsApp -->
  <Task sr="task2">
    <cdate>1234567890</cdate>
    <edate>1234567890</edate>
    <id>2</id>
    <nme>Forward SMS to WhatsApp</nme>
    
    <!-- Action 1: Filter verification codes (optional) -->
    <Action sr="act0" ve="7">
      <code>37</code>
      <Str sr="arg0" ve="3">%SMSRB</Str>
      <Str sr="arg1" ve="3">.*\d{4,6}.*|verification|code|OTP</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Str sr="arg5" ve="3"/>
      <Int sr="arg6" val="1"/>
    </Action>
    
    <!-- Action 2: Set WhatsApp phone number -->
    <Action sr="act1" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%WhatsAppNumber</Str>
      <Str sr="arg1" ve="3">+1234567890</Str>
      <!-- Replace with your actual WhatsApp number -->
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>
    
    <!-- Action 3: Format message -->
    <Action sr="act2" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%MessageText</Str>
      <Str sr="arg1" ve="3">📱 SMS from %SMSRF
━━━━━━━━━━
%SMSRB</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>
    
    <!-- Action 4: Send to WhatsApp -->
    <Action sr="act3" ve="7">
      <code>301</code>
      <Str sr="arg0" ve="3">android.intent.action.SENDTO</Str>
      <Str sr="arg1" ve="3">smsto:%WhatsAppNumber</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3">sms_body:%MessageText</Str>
      <Str sr="arg5" ve="3">com.whatsapp</Str>
      <Int sr="arg6" val="1"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>
    
    <!-- Action 5: Notification of successful forward -->
    <Action sr="act4" ve="7">
      <code>523</code>
      <label>Success Notification</label>
      <Str sr="arg0" ve="3">SMS Forwarded</Str>
      <Str sr="arg1" ve="3">Message from %SMSRF forwarded to WhatsApp</Str>
      <Img sr="arg2" ve="2"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Str sr="arg5" ve="3"/>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>
  </Task>
</TaskerData>
